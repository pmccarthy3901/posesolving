   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "931edfb7-0988-4a76-a53f-1f3ee1d3651e",
   "metadata": {},
   "outputs": [],
   "source": [
    "xs = np.linspace(-3,10,100)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "1a584078-9739-4388-991f-1fedb5ea0b59",
   "metadata": {},
   "outputs": [],
   "source": [
    "ys = xs * np.cos(xs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "ea9a23b6-4aad-4273-8008-507a4cf09909",
   "metadata": {},
